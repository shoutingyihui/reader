# API server port
PORT=8787

# Allowed article hosts (comma separated, must be within default allowlist)
ALLOWED_HOSTS=mp.weixin.qq.com

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# Allowed image hosts (comma separated, must be within default allowlist)
IMAGE_HOSTS=mmbiz.qpic.cn,mmbiz.qlogo.cn

# Cache settings
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=100
